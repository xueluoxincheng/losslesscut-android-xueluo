    <!-- Tooltips -->
    <string name="tooltip_strategy_scene">检测镜头之间的硬切。最适合将电影或多机位素材分割成独立场景。</string>
    <string name="tooltip_strategy_black">检测全黑帧。用于查找并移除“淡出至黑”转场或空白间隙。</string>
    <string name="tooltip_strategy_freeze">检测连续帧相同的冻结视频片段。用于过滤静止暂停或画面卡顿。</string>
    <string name="tooltip_strategy_blur">检测模糊或失焦的素材，以自动过滤掉废片。</string>
    <string name="tooltip_sample_interval">分析频率。较低的间隔（100–200ms）提高精度但分析较慢；较高的间隔（500ms+）分析更快但可能会遗漏快速剪切。</string>
    <string name="tooltip_sensitivity">检测阈值。较低的值检测微妙变化；较高的值仅在发生明显重大变化时触发。</string>
    <string name="tooltip_min_segment">保留片段的最短持续时间。增加此值可防止在时间轴上出现短小、不连贯的碎片。</string>
    <string name="tooltip_noise_threshold" formatted="false">低于此音频级别的音量被视为静音。如果背景噪音（嗡嗡声、空调声、呼吸声）导致无法剪切，请增加此值。</string>
    <string name="tooltip_min_segment_audio">保留音频片段的最短持续时间。较低的值保留短词；较高的值过滤咳嗽或麦克风碰撞等短暂噪音。</string>
    <string name="tooltip_min_silence_duration">触发剪切所需的最短静音持续时间。较低的值产生紧凑的节奏；较高的值保留自然的停顿。</string>
    <string name="tooltip_padding_prefix">在保留片段开始前添加的填充。防止词语开头感觉被切断。</string>
    <string name="tooltip_padding_postfix">在保留片段结束后添加的填充。防止音频切断过于突然。</string>
    <string name="tooltip_detect">开始帧分析。应用前，您可以在时间轴上调整并查看预览范围。</string>
    <string name="tooltip_apply_smart_cut">应用剪切。在主时间轴上丢弃红色片段并合并绿色片段。</string>
    <string name="tooltip_silence_tab">检测并移除静音停顿。非常适合播客、讲座或口播视频。</string>
